<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\AddToMonitoringQueueInterface" type="MageSuite\ProductVisibilityMonitoring\Service\AddToMonitoringQueue"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\CategoryProductsLogRepositoryInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CategoryProductsLogRepository"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\CategoryProductsNotificationLogRepositoryInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CategoryProductsNotificationLogRepository"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\CountProductsInCategoryInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CountProductsInCategory"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\Data\CategoryProductsLogInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CategoryProductsLog"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\Data\CategoryProductsNotificationLogInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CategoryProductsNotificationLog"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\Data\CategoryProductsQueueLogInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CategoryProductsQueueLog"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\MonitorInterface" type="MageSuite\ProductVisibilityMonitoring\Service\Monitor"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\NotificationInterface" type="MageSuite\ProductVisibilityMonitoring\Service\Notification"/>
    <preference for="MageSuite\ProductVisibilityMonitoring\Api\CategoryProductsQueueLogRepositoryInterface" type="MageSuite\ProductVisibilityMonitoring\Model\CategoryProductsQueueLogRepository"/>

    <type name="MageSuite\ProductVisibilityMonitoring\Model\CanAddToQueue">
        <arguments>
            <argument name="allowedRequestParams" xsi:type="array">
                <item name="id" xsi:type="string">id</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\ProductVisibilityMonitoring\Service\Monitor">
        <arguments>
            <argument name="monitorActions" xsi:type="array">
                <item name="insert_history_log" xsi:type="object">MageSuite\ProductVisibilityMonitoring\Service\MonitorAction\InsertHistoryLog</item>
                <item name="notify_about_zero_products" xsi:type="object">MageSuite\ProductVisibilityMonitoring\Service\MonitorAction\NotifyAboutZeroProducts</item>
            </argument>
        </arguments>
    </type>

    <type name="MageSuite\ProductVisibilityMonitoring\Service\AddToMonitoringQueue">
        <arguments>
            <argument name="handler" xsi:type="string">MageSuite\ProductVisibilityMonitoring\Service\MonitoringQueueHandler</argument>
        </arguments>
    </type>

    <type name="MageSuite\ProductVisibilityMonitoring\Model\CountProductsInCategory">
        <arguments>
            <argument name="collectionFactory" xsi:type="object">Magento\CatalogSearch\Model\ResourceModel\Fulltext\CollectionFactory</argument>
        </arguments>
    </type>
</config>
